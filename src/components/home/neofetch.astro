---
// A neofetch-style terminal window: the photo where neofetch prints its logo, "system info" about
// me beside it. The window is dark in both themes, so it uses a fixed teal instead of the theme
// accent (which is a deep teal in light mode).
const info = [
	["role", "Senior Principal Engineer"],
	["focus", "scalable, cloud-native apps"],
	["stack", "Python · Node.js"],
	["cloud", "AWS · GCP"],
	["also", "architecture & design"],
	["location", "Spain"],
	["status", "curious by nature"],
];

// neofetch's row of terminal colors
const swatches = [
	"bg-neutral-700",
	"bg-red-400",
	"bg-green-400",
	"bg-yellow-400",
	"bg-blue-400",
	"bg-fuchsia-400",
	"bg-teal-400",
	"bg-neutral-200",
];
---

<div
  class="overflow-hidden font-mono text-xs border shadow-2xl lg:text-[13px] rounded-xl bg-neutral-950 border-neutral-800 shadow-neutral-900/20 dark:shadow-black/50"
>
  <div
    class="relative flex items-center h-9 px-4 border-b border-neutral-800 bg-neutral-900"
  >
    <div class="flex gap-1.5" aria-hidden="true">
      <span class="w-3 h-3 rounded-full bg-neutral-700"></span>
      <span class="w-3 h-3 rounded-full bg-neutral-700"></span>
      <span class="w-3 h-3 rounded-full bg-neutral-700"></span>
    </div>
    <p class="absolute inset-x-0 text-center pointer-events-none text-neutral-500">
      maldo@dev: ~
    </p>
  </div>

  <div class="p-5 leading-relaxed text-neutral-300">
    <p><span class="text-teal-400">$</span> neofetch</p>

    <div class="flex flex-col gap-5 mt-4 sm:flex-row">
      <div
        class="relative w-24 h-24 overflow-hidden rounded-lg shrink-0 sm:w-28 sm:h-28 bg-gradient-to-b from-teal-900/60 to-neutral-900 ring-1 ring-neutral-800"
      >
        <img
          src="/assets/images/me.png"
          alt="Maldo"
          width="720"
          height="1080"
          loading="eager"
          class="absolute inset-x-0 top-0 object-cover object-top w-full translate-y-1 scale-125"
        />
      </div>

      <div class="min-w-0">
        <p class="font-semibold text-teal-400">maldo<span class="text-neutral-300">@</span>dev</p>
        <p class="text-neutral-600" aria-hidden="true">---------</p>
        <dl class="grid grid-cols-[auto_1fr] gap-x-3">
          {
            info.map(([key, value]) => (
              <>
                <dt class="text-teal-400">{key}</dt>
                <dd class="text-neutral-200">{value}</dd>
              </>
            ))
          }
        </dl>
        <div class="flex mt-3" aria-hidden="true">
          {swatches.map((color) => <span class={`w-4 h-3 ${color}`} />)}
        </div>
      </div>
    </div>

    <p class="mt-4">
      <span class="text-teal-400">$</span>
      <span class="inline-block w-2 h-4 align-middle cursor bg-teal-400" aria-hidden="true"></span>
    </p>
  </div>
</div>
