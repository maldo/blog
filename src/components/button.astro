---
const { link, text } = Astro.props;
---

<a
  href={link}
  class="inline-flex items-center w-auto gap-1 px-4 py-2 mt-5 font-mono text-xs font-medium duration-300 ease-out border rounded-md border-accent bg-accent text-accent-contrast hover:bg-transparent hover:text-accent"
>
  {text}
  <span aria-hidden="true">&rarr;</span>
</a>
