---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../assets/css/main.css";
import Footer from "../components/footer.astro";
import Header from "../components/header.astro";
import SquareLines from "../components/square-lines.astro";
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Used to add dark mode right away, adding here prevents any flicker.
         A choice saved with the toggle wins; otherwise follow the system setting. -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('dark_mode')
        const dark =
          saved === null
            ? window.matchMedia('(prefers-color-scheme: dark)').matches
            : saved === 'true'
        if (dark) document.documentElement.classList.add('dark')
      } catch (e) {}
    </script>
    <link rel="icon" type="image/x-icon" href="../assets/images/favicon.png" />
    <Fragment set:html={import.meta.env.HEADER_INJECT} />
  </head>
  <body
    class="font-sans antialiased text-neutral-900 bg-white dark:bg-neutral-950 dark:text-neutral-100"
  >
    <SquareLines />
    <Header />
    <slot />
    <Footer />
    <script src="../assets/js/main.js"></script>
    <Fragment set:html={import.meta.env.FOOTER_INJECT} />
  </body>
</html>
