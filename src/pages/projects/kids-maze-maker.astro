---
import PageHeading from "@/components/page-heading.astro";
import "@/assets/css/puzzles.css";
import Layout from "@/layouts/main.astro";
import { AGE_PRESETS, ALGORITHMS, E, MAX_SIZE, MIN_SIZE, N, S, W } from "@/lib/puzzles/maze";
import { characters, landscapes } from "@/lib/puzzles/themes";
---

<Layout title="Kids Maze Maker">
  <section class="relative z-20 max-w-4xl mx-auto my-12 px-7 lg:px-0">
    <PageHeading
      title="Kids Maze Maker"
      description="Pick an age, a character and a place — then print a fresh maze to solve, or play it in 3D! Share the link and anyone gets the same maze."
    />

    <div class="mt-10 space-y-8" id="maze-app">

      <!-- Step 1: Age -->
      <div class="pz-section">
        <h3 class="pz-title"><span class="pz-badge">1</span> How Old Is the Explorer?</h3>
        <div class="pz-chips" id="age-chips">
          {AGE_PRESETS.map((p) => (
            <button type="button" class="pz-chip" data-age={p.id}>
              {p.label}
              <small>{p.size}×{p.size}</small>
            </button>
          ))}
        </div>
        <p class="pz-hint" id="age-hint"></p>
      </div>

      <!-- Step 2: Character -->
      <div class="pz-section">
        <h3 class="pz-title"><span class="pz-badge">2</span> Pick a Character</h3>
        <div class="pz-grid">
          {characters.map((c) => (
            <button type="button" class="pz-card" data-category="char" data-value={c.id}>
              <span class="pz-emoji">{c.emoji}</span>
              <span class="pz-label">{c.label}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Step 3: Place -->
      <div class="pz-section">
        <h3 class="pz-title"><span class="pz-badge">3</span> Pick a Place</h3>
        <div class="pz-grid">
          {landscapes.map((l) => (
            <button type="button" class="pz-card" data-category="place" data-value={l.id}>
              <span class="pz-emoji">{l.emoji}</span>
              <span class="pz-label">{l.label}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Step 4: Tweaks -->
      <div class="pz-section">
        <h3 class="pz-title"><span class="pz-badge">4</span> Make It Easier or Harder</h3>
        <label class="pz-hint block mb-2 mt-0" for="size-range">
          Size: <span id="size-value"></span>
        </label>
        <input
          id="size-range"
          class="pz-range"
          type="range"
          min={MIN_SIZE}
          max={MAX_SIZE}
          step="1"
        />
        <div class="pz-chips mt-5" id="algo-chips">
          {ALGORITHMS.map((a) => (
            <button type="button" class="pz-chip" data-algo={a.id}>
              {a.label}
              <small>{a.blurb}</small>
            </button>
          ))}
        </div>
      </div>

      <!-- Actions -->
      <div class="pz-bar">
        <button type="button" id="new-btn" class="pz-btn pz-btn-primary">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          New maze
        </button>
        <button type="button" id="play-btn" class="pz-btn pz-btn-play">
          <svg fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5.14v13.72a1 1 0 001.5.86l11-6.86a1 1 0 000-1.72l-11-6.86A1 1 0 008 5.14z" />
          </svg>
          Play in 3D
        </button>
        <button type="button" id="print-btn" class="pz-btn pz-btn-solid">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          Print
        </button>
        <button type="button" id="copy-btn" class="pz-btn pz-btn-soft">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
          </svg>
          Copy link
        </button>
        <label class="pz-toggle">
          <input type="checkbox" id="answer-toggle" />
          Include answer key
        </label>
        <span class="pz-toast" id="toast" role="status" aria-live="polite"></span>
      </div>

      <!-- Puzzle -->
      <div class="pz-paper" id="maze-paper">
        <h3 id="maze-heading"></h3>
        <div id="maze-svg"></div>
      </div>

      <div class="pz-paper hidden" id="answer-paper">
        <p class="pz-paper-note">Answer key — prints on page 2</p>
        <div id="answer-svg"></div>
      </div>

    </div>
  </section>

  <!-- Play mode: the same maze in 3D. The game itself loads on first open. -->
  <dialog class="pz-play" id="play-dialog" aria-labelledby="play-heading">
    <div class="pz-play-bar">
      <h2 id="play-heading"></h2>
      <span class="pz-play-steps" id="play-steps"></span>
      <button type="button" id="hint-btn" class="pz-btn pz-btn-soft pz-btn-sm">{"\u{1F4A1}"} Hint</button>
      <button type="button" id="view-btn" class="pz-btn pz-btn-soft pz-btn-sm"></button>
      <button type="button" id="play-close" class="pz-play-close" aria-label="Close">&times;</button>
    </div>
    <div class="pz-play-stage" id="play-stage">
      <p class="pz-play-msg" id="play-msg"></p>
      <div class="pz-win" id="win-panel" role="status" hidden>
        <div class="pz-win-card">
          <p class="pz-win-emoji">{"\u{1F389}"}</p>
          <h3>You did it!</h3>
          <p id="win-text"></p>
          <div class="pz-win-actions">
            <button type="button" id="again-btn" class="pz-btn pz-btn-soft">Play again</button>
            <button type="button" id="next-btn" class="pz-btn pz-btn-primary">New maze</button>
          </div>
        </div>
      </div>
    </div>
    <div class="pz-dpad" role="group" aria-label="Move">
      <button type="button" data-dir={N} aria-label="Up">&#9650;</button>
      <button type="button" data-dir={W} aria-label="Left">&#9664;</button>
      <button type="button" data-dir={E} aria-label="Right">&#9654;</button>
      <button type="button" data-dir={S} aria-label="Down">&#9660;</button>
    </div>
    <p class="pz-play-help">Use the arrow keys, drag on the maze, or tap the arrows to move.</p>
  </dialog>
</Layout>

<!-- Print-only view, filled by the script below -->
<div id="print-container"></div>

<script>
  import {
    AGE_PRESETS,
    ALGORITHMS,
    type Algorithm,
    E,
    type MazePuzzle,
    type MazeSettings,
    N,
    S,
    W,
    agePreset,
    buildMaze,
    mazeHeading,
    parseSettings,
    renderMazeSvg,
    settingsForAge,
    settingsToParams,
  } from "@/lib/puzzles/maze";
  import type { MazeGame } from "@/lib/puzzles/maze-3d";
  import { newSeed } from "@/lib/puzzles/random";

  let settings: MazeSettings = parseSettings(
    new URLSearchParams(location.search),
    newSeed(),
  );

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const answerToggle = $<HTMLInputElement>("answer-toggle");
  const sizeRange = $<HTMLInputElement>("size-range");

  let puzzle: MazePuzzle;

  function render() {
    puzzle = buildMaze(settings);
    const heading = mazeHeading(puzzle);
    const maze = renderMazeSvg(puzzle);
    const solved = renderMazeSvg(puzzle, true);
    const withKey = answerToggle.checked;

    $("maze-heading").textContent = heading;
    $("maze-svg").innerHTML = maze;
    $("answer-svg").innerHTML = solved;
    $("answer-paper").classList.toggle("hidden", !withKey);

    const sheet = (title: string, svg: string, note = "") =>
      `<section class="print-sheet"><h1>${title}</h1>${note}${svg}</section>`;
    $("print-container").innerHTML =
      sheet(heading, maze) + (withKey ? sheet("Answer key", solved) : "");

    // Controls
    for (const el of document.querySelectorAll<HTMLElement>("[data-age]"))
      el.classList.toggle("selected", el.dataset.age === settings.age);
    for (const el of document.querySelectorAll<HTMLElement>("[data-algo]"))
      el.classList.toggle("selected", el.dataset.algo === settings.algo);
    for (const el of document.querySelectorAll<HTMLElement>(".pz-card")) {
      const key = el.dataset.category as "char" | "place";
      el.classList.toggle("selected", el.dataset.value === settings[key]);
    }
    sizeRange.value = String(settings.size);
    $("size-value").textContent = `${settings.size} × ${settings.size}`;
    const preset = agePreset(settings.age);
    const algo = ALGORITHMS.find((a) => a.id === settings.algo);
    $("age-hint").textContent = preset.wide
      ? "Extra-wide corridors and a short trip, perfect for little hands."
      : `${algo?.blurb ?? ""}. The finish is the farthest spot from the start.`;

    history.replaceState(null, "", `${location.pathname}?${settingsToParams(settings)}`);
  }

  function update(patch: Partial<MazeSettings>) {
    settings = { ...settings, ...patch };
    render();
  }

  for (const el of document.querySelectorAll<HTMLElement>("[data-age]")) {
    el.addEventListener("click", () => {
      const age = AGE_PRESETS.find((p) => p.id === el.dataset.age);
      if (!age) return;
      // An age preset resets size and algorithm, but keeps the seed and the theme.
      const base = settingsForAge(age.id, settings.seed, settings.char, settings.place);
      update(base);
    });
  }
  for (const el of document.querySelectorAll<HTMLElement>("[data-algo]"))
    el.addEventListener("click", () => update({ algo: el.dataset.algo as Algorithm }));
  for (const el of document.querySelectorAll<HTMLElement>(".pz-card"))
    el.addEventListener("click", () =>
      update({ [el.dataset.category as "char" | "place"]: el.dataset.value! }),
    );
  sizeRange.addEventListener("input", () => update({ size: Number(sizeRange.value) }));
  answerToggle.addEventListener("change", render);

  $("new-btn").addEventListener("click", () => update({ seed: newSeed() }));
  $("print-btn").addEventListener("click", () => window.print());

  let toastTimer: number | undefined;
  $("copy-btn").addEventListener("click", async () => {
    let message = "Link copied!";
    try {
      await navigator.clipboard.writeText(location.href);
    } catch {
      message = "Copy the link from the address bar.";
    }
    const toast = $("toast");
    toast.textContent = message;
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.textContent = "";
    }, 2500);
  });

  // ---- Play in 3D ----

  const dialog = $<HTMLDialogElement>("play-dialog");
  const stage = $("play-stage");
  const message = $("play-msg");
  const winPanel = $("win-panel");
  let game: MazeGame | null = null;
  let opening = 0;
  let winTimer: number | undefined;

  const showSteps = (steps: number) => {
    $("play-steps").textContent = `\u{1F463} ${steps} ${steps === 1 ? "step" : "steps"}`;
  };
  const showView = () => {
    $("view-btn").textContent =
      game?.view === "close" ? "\u{1F52D} Whole maze" : "\u{1F50D} Zoom in";
  };

  function hideWin() {
    clearTimeout(winTimer);
    winPanel.hidden = true;
  }

  function onWin(steps: number) {
    const { character: c, landscape: l } = puzzle;
    const shortest = puzzle.solution.length - 1;
    $("win-text").textContent =
      `The ${c.emoji} ${c.label.toLowerCase()} reached the ${l.emoji} ${l.label.toLowerCase()} in ${steps} steps. ` +
      (steps <= shortest ? "That's the shortest way — amazing!" : `The shortest way is ${shortest} steps.`);
    // Give the confetti a moment before the card covers the finish.
    const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
    winTimer = window.setTimeout(() => {
      winPanel.hidden = false;
      $("next-btn").focus();
    }, calm ? 0 : 1400);
  }

  async function startGame() {
    const ticket = ++opening;
    game?.dispose();
    game = null;
    hideWin();
    message.hidden = false;
    message.textContent = "Building your maze…";
    $("play-heading").textContent = mazeHeading(puzzle);
    showSteps(0);
    try {
      const { createMazeGame } = await import("@/lib/puzzles/maze-3d");
      // Closed, or started again, while the 3D code was loading.
      if (ticket !== opening || !dialog.open) return;
      game = createMazeGame(stage, puzzle, { onStep: showSteps, onWin });
      message.hidden = true;
    } catch {
      message.textContent = "Sorry, this browser can't show the 3D maze. Try printing it instead!";
    }
    showView();
  }

  $("play-btn").addEventListener("click", () => {
    dialog.showModal();
    startGame();
  });
  $("play-close").addEventListener("click", () => dialog.close());
  dialog.addEventListener("close", () => {
    opening++;
    hideWin();
    game?.dispose();
    game = null;
  });

  $("hint-btn").addEventListener("click", () => game?.hint());
  $("view-btn").addEventListener("click", () => {
    game?.setView(game.view === "close" ? "whole" : "close");
    showView();
  });
  $("again-btn").addEventListener("click", () => {
    hideWin();
    game?.restart();
  });
  $("next-btn").addEventListener("click", () => {
    update({ seed: newSeed() });
    startGame();
  });

  const KEYS: Record<string, number> = {
    arrowup: N,
    w: N,
    arrowright: E,
    d: E,
    arrowdown: S,
    s: S,
    arrowleft: W,
    a: W,
  };
  dialog.addEventListener("keydown", (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    const dir = KEYS[e.key.toLowerCase()];
    if (dir && game) {
      e.preventDefault();
      game.move(dir);
    } else if (e.key.toLowerCase() === "h") game?.hint();
  });

  // Arrow buttons: press to step, hold to keep walking.
  for (const el of document.querySelectorAll<HTMLButtonElement>("[data-dir]")) {
    const dir = Number(el.dataset.dir);
    let timer: number | undefined;
    const stop = () => clearInterval(timer);
    el.addEventListener("pointerdown", (e) => {
      e.preventDefault();
      game?.move(dir);
      stop();
      timer = window.setInterval(() => game?.move(dir), 170);
    });
    for (const type of ["pointerup", "pointerleave", "pointercancel"]) el.addEventListener(type, stop);
    // Enter or Space on a focused arrow; pointer presses are handled above.
    el.addEventListener("click", (e) => {
      if (e.detail === 0) game?.move(dir);
    });
  }

  render();
</script>
