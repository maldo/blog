---
import Button from "../components/button.astro";
import Neofetch from "../components/home/neofetch.astro";
import Projects from "../components/home/projects.astro";
import Writings from "../components/home/writings.astro";
import Prompt from "../components/prompt.astro";
import Layout from "../layouts/main.astro";
---

<Layout title="maldo.dev">
  <div
    class="relative z-20 w-full max-w-4xl mx-auto mt-16 px-7 md:mt-24 lg:mt-32 xl:px-0"
  >
    <div class="flex flex-col gap-12 md:flex-row md:items-center md:gap-10">
      <div class="relative w-full md:w-5/12">
        <Prompt command="whoami" />
        <h1
          class="mb-5 text-4xl font-bold leading-tight tracking-tight lg:text-6xl"
        >
          Hello, I'm Maldo.
        </h1>
        <p class="mb-2 text-base leading-relaxed text-neutral-600 dark:text-neutral-400">
          I build things and write about it. Software Engineer, Engineering
          Manager & <span class="font-semibold text-accent">curious by nature</span>.
        </p>
        <div class="flex flex-wrap items-center gap-x-5">
          <Button text="Follow me on 𝕏" link="https://x.com/MaldoDev" />
          <a
            href="/about"
            class="mt-5 font-mono text-xs duration-200 text-neutral-600 dark:text-neutral-400 hover:text-accent"
            >cd ~/about</a
          >
        </div>
      </div>
      <div class="relative w-full md:w-7/12">
        <Neofetch />
      </div>
    </div>
  </div>

  <div class="mt-24 sm:mt-32">
    <Writings />
  </div>
  <div class="mt-24 sm:mt-32">
    <Projects />
  </div>
</Layout>
